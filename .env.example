# =============================================================================
# EaseMyOffice CRM - Environment Variables Template
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in the real values.
# NEVER commit the real ".env" file to git (it is gitignored).
# =============================================================================
#
# ### READ THIS BEFORE DEPLOYING: VITE_* vars are needed at BUILD time ########
#
# The two variable groups below behave completely differently, and mixing them
# up is the single most common way to end up with a deployed site that loads a
# blank page or throws "Missing Supabase environment variable(s)".
#
#   VITE_* vars  -> consumed at BUILD time. Vite statically replaces every
#                   `import.meta.env.VITE_FOO` with the literal value while
#                   compiling, so the value is hard-baked into the JS that ships
#                   to the browser. If a VITE_* var is absent during the build,
#                   the compiled bundle contains `undefined` FOREVER, and no
#                   amount of runtime configuration can repair it.
#
#   non-VITE_*   -> consumed at RUN time via process.env, inside the Worker
#                   only. Safe for secrets; never sent to the browser.
#
# Consequence for Cloudflare: setting these only as Worker Variables/Secrets is
# NOT enough. Worker bindings are runtime-only, so the client bundle was already
# compiled blind. The VITE_* vars must ALSO be present in the environment that
# runs `vite build`:
#
#   Workers & Pages -> your project -> Settings -> Environment variables
#   -> make sure they are set for the BUILD (not just at runtime), then
#      trigger a fresh deploy so the bundle is recompiled with real values.
#
# Because VITE_* values are publicly visible in the shipped JS, only ever put
# non-sensitive values behind a VITE_ prefix. The Supabase publishable/anon key
# is designed to be public (it is guarded by Row Level Security). NEVER give
# SUPABASE_SERVICE_ROLE_KEY — or any other secret below — a VITE_ prefix.
#
# #############################################################################

# --- Supabase: REQUIRED (core CRM will not work without these) ---------------
# Find these in your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-ref
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-SUPABASE-ANON-PUBLISHABLE-KEY
SUPABASE_PUBLISHABLE_KEY=YOUR-SUPABASE-ANON-PUBLISHABLE-KEY

# Secret admin key - SERVER SIDE ONLY. Set this in Cloudflare, NOT in the repo.
# Find it in Supabase: Settings -> API -> service_role (keep this private!)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# --- Site URL: REQUIRED (used for auth redirects & emails) -------------------
# During local dev this is usually http://localhost:3000
# In production, set it to your live Cloudflare URL.
VITE_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- Optional integrations (leave blank until you need them) -----------------
# Email sending (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# WhatsApp reminders (Twilio)
TWILIO_API_KEY=
TWILIO_WHATSAPP_FROM=

# Google Sheets sync
GOOGLE_SHEETS_API_KEY=

# Lovable AI (only if you keep using Lovable AI features)
LOVABLE_API_KEY=
